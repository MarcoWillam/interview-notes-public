# Copy to a private file outside version control, then use INTERVIEW_ENV_FILE.
INTERVIEW_PUBLIC_ORIGIN=https://your-workspace.example
INTERVIEW_PORT=8787
INTERVIEW_DATA_DIR=/var/lib/interview-notes
# Only used when the database has no users. Password must be 12–200 characters.
INTERVIEW_ADMIN_USER=owner
INTERVIEW_ADMIN_PASSWORD=
# Do not configure any Codex or model credentials on this server.
