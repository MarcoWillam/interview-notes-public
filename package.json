{
  "name": "interview-notes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && vite build --config vite.queue.config.ts",
    "start": "node --experimental-strip-types server/start.ts --preview",
    "lint": "oxlint app lib server hooks/use-recorder.ts hooks/use-local-access.ts hooks/use-interview-library.ts components/interview tests vite.config.ts web vite.queue.config.ts",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start:api": "wrangler dev --config dist/server/wrangler.json --env-file \"$PWD/.env\"",
    "start:server": "node --experimental-strip-types server/start.ts",
    "start:local": "node --experimental-strip-types server/start-local.ts",
    "connector": "node --experimental-strip-types server/connector.ts",
    "build:server": "vite build --config vite.queue.config.ts",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "prebuild:server": "node scripts/prepare-pdf-assets.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fflate": "0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "mammoth": "1.12.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260907.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "type": "module"
}
